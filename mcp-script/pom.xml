<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.yulinlin</groupId>
        <artifactId>data</artifactId>
        <version>3.0</version>
    </parent>
    <artifactId>mcp-script</artifactId>
    <description>MCP 可选模块：data.analyze 服务端 JavaScript 沙箱（GraalJS）。引入即启用，需要配置 yulinlin.mcp.data.read 或 write。</description>

    <properties>
        <!-- org.graalvm.polyglot:js 25.2.x 为 MIT / UPL 许可；js-community 已标记弃用 -->
        <graaljs.version>25.2.4</graaljs.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.yulinlin</groupId>
            <artifactId>mcp-data</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.yulinlin</groupId>
            <artifactId>jdbc</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.graalvm.polyglot</groupId>
            <artifactId>polyglot</artifactId>
            <version>${graaljs.version}</version>
        </dependency>
        <dependency>
            <groupId>org.graalvm.polyglot</groupId>
            <artifactId>js</artifactId>
            <version>${graaljs.version}</version>
            <type>pom</type>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.yulinlin</groupId>
            <artifactId>h2</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
